--!strict
-- Sound effects. The audio files live in assets/sounds/ (generated by
-- tools/make_sounds.py). Roblox can only play audio uploaded to Roblox, so:
--
--   1. Upload each .ogg in assets/sounds/ (Studio: View > Asset Manager >
--      Bulk Import, or Creator Hub > Development Items > Audio).
--   2. Paste each uploaded asset's ID below, e.g. id = "rbxassetid://1234567".
--
-- Sounds with an empty id are skipped silently, so the game runs fine before
-- the uploads are done. Swap in any Creator Store sound the same way.

export type SoundDef = {
	id: string,
	volume: number,
	-- Random playback speed range; small variation keeps repeats from
	-- sounding robotic.
	pitch: { number },
}

local Sounds: { [string]: SoundDef } = {
	Squish = { id = "", volume = 0.7, pitch = { 0.9, 1.15 } }, -- harvest (squish.ogg)
	Pop = { id = "", volume = 0.6, pitch = { 0.9, 1.2 } }, -- plant (pop.ogg)
	Coin = { id = "", volume = 0.5, pitch = { 0.98, 1.05 } }, -- buy seed (coin.ogg)
	Sell = { id = "", volume = 0.6, pitch = { 1, 1 } }, -- sell (sell.ogg)
	Click = { id = "", volume = 0.35, pitch = { 0.95, 1.1 } }, -- UI buttons (click.ogg)
	Dig = { id = "", volume = 0.6, pitch = { 0.9, 1.1 } }, -- shovel (dig.ogg)
	Sparkle = { id = "", volume = 0.6, pitch = { 1, 1 } }, -- new mutation / rare harvest (sparkle.ogg)
	Star = { id = "", volume = 0.8, pitch = { 1, 1 } }, -- shooting star (star.ogg)
	Weather = { id = "", volume = 0.5, pitch = { 1, 1 } }, -- weather starts (weather.ogg)
	Error = { id = "", volume = 0.5, pitch = { 1, 1 } }, -- can't do that (error.ogg)
}

return Sounds
